generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  supabaseId    String         @unique
  email         String
  name          String?
  avatarUrl     String?
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentSlug String    @default("agenta")
  title     String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, agentSlug])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model AgentRelease {
  id         String   @id @default(cuid())
  agentSlug  String
  version    Int
  modelId    String
  promptHash String
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())

  turns AgentTurnMetric[]

  @@unique([agentSlug, version])
  @@index([agentSlug, isActive])
}

model AgentTurnMetric {
  id              String   @id @default(cuid())
  conversationId  String
  agentSlug       String
  releaseId       String
  release         AgentRelease @relation(fields: [releaseId], references: [id])
  durationMs      Int
  toolCallCount   Int
  toolErrorCount  Int
  errorCategories Json?
  x402Success     Boolean?
  x402Usdc        Float?
  citationCount   Int?
  briefComplete   Boolean?
  escalated       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([agentSlug, createdAt])
  @@index([releaseId])
}
